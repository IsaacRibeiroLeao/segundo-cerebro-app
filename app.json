{
  "expo": {
    "name": "Segundo Cérebro",
    "slug": "segundo-cerebro",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf6ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.isaacleaodev.segundocerebro",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf6ef",
          "dark": {
            "backgroundColor": "#16130f"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita o microfone para ditar suas notas.",
          "speechRecognitionPermission": "Permita o reconhecimento de voz para ditar suas notas.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher sua foto de perfil."
        }
      ]
    ]
  }
}